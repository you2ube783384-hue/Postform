# Database (SQLite / Turso)
#
# LOCAL DEVELOPMENT — local SQLite file (no token needed).
# Keep TURSO_DATABASE_URL pointed at the local file so local dev never
# writes to the production Turso database:
DATABASE_URL=file:./db/custom.db
TURSO_DATABASE_URL=file:./db/custom.db
#
# PRODUCTION (e.g. Vercel) — ZERO CONFIG REQUIRED.
# src/lib/db.ts bakes in the production Turso URL + token as fallback
# defaults, so Vercel deploys work without setting any env vars.
#
# OPTIONAL OVERRIDES — set these on the host (Vercel → Settings →
# Environment Variables) to replace the baked-in defaults, e.g. after
# rotating the Turso token or pointing at a different database:
#        TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
#        TURSO_AUTH_TOKEN=eyJ...
#        ADMIN_PASSWORD=<strong password>            # default: postform-admin-2026 (dev only!)
#        ADMIN_SESSION_SECRET=<random long string>
#        NEXT_PUBLIC_STORE_EMAIL=postformproducts@haren.uk
#        NEXT_PUBLIC_SITE_URL=https://your-domain.com
#
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=eyJ...
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# NEXT_PUBLIC_STORE_EMAIL=postformproducts@haren.uk
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
