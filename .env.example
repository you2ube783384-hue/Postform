# Database (SQLite / Turso)
#
# LOCAL DEVELOPMENT — local SQLite file (no token needed):
DATABASE_URL=file:./db/custom.db
TURSO_DATABASE_URL=file:./db/custom.db
#
# PRODUCTION (e.g. Vercel) — hosted Turso (libsql) database:
#   1. Create a database at https://turso.tech (or `turso db create postform`)
#   2. Copy schema + data from the local SQLite file:
#        TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io \
#        TURSO_AUTH_TOKEN=eyJ... \
#        node scripts/push-to-turso.mjs
#   3. Set these env vars on your host (Vercel → Settings → Environment Variables):
#        TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
#        TURSO_AUTH_TOKEN=eyJ...
#        ADMIN_PASSWORD=<strong password>            # default: postform-admin-2026 (dev only!)
#        ADMIN_SESSION_SECRET=<random long string>
#        NEXT_PUBLIC_STORE_EMAIL=postformproducts@haren.uk
#        NEXT_PUBLIC_SITE_URL=https://your-domain.com
#
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=eyJ...
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# NEXT_PUBLIC_STORE_EMAIL=postformproducts@haren.uk
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
